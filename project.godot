; Engine configuration file.
; Prefer editing through the Godot editor when changing platform-specific settings.

config_version=5

[application]

config/name="萌宠小镇数学冒险"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/app_icon.svg"
boot_splash/bg_color=Color(0.929, 0.976, 0.945, 1)
boot_splash/show_image=false

[autoload]

ContentRepository="*res://scripts/autoload/content_repository.gd"
ProgressStore="*res://scripts/autoload/progress_store.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.929, 0.976, 0.945, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true
